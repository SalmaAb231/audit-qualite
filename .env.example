# Copier ce fichier vers .env pour le développement ou vers
# ~/audit-qualite.env sur EC2, puis renseigner sa propre clé OpenRouter.
# Ne jamais publier le fichier réel ni ajouter de credentials AWS permanents.
OPENROUTER_API_KEY=<your-openrouter-api-key>

# Configuration du déploiement AWS validé.
STORAGE_MODE=S3
AWS_REGION=eu-west-1
S3_BUCKET=<bucket-name>
S3_INPUT_PREFIX=input/
S3_REPORTS_PREFIX=reports/
S3_QUARANTINE_PREFIX=quarantine/
S3_HISTORY_PREFIX=history/

# Pour un usage local, remplacer STORAGE_MODE par local.
DATA_DIR=./data

# Cache dashboard des artefacts immuables (HTML/JSON/source), en secondes.
ARTIFACT_CACHE_TTL_SECONDS=900
