# Copier ce fichier vers .env et renseigner ses propres identifiants.
# Ne jamais publier le fichier .env.
OPENROUTER_API_KEY=
DATA_DIR=./data
STORAGE_MODE=local

# Facultatif : uniquement pour l'utilisation de S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET=audit-qualite-leasing-pfa-hn-2026-01-239280167189-eu-west-1-an
S3_INPUT_PREFIX=input/
S3_REPORTS_PREFIX=reports/
S3_QUARANTINE_PREFIX=quarantine/
S3_HISTORY_PREFIX=history/

# Cache dashboard des artefacts immuables (HTML/JSON/source), en secondes.
ARTIFACT_CACHE_TTL_SECONDS=900
