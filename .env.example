# --- OpenRouter (obligatoire dès maintenant) ---
# Clé API OpenRouter personnelle, utilisée par tous les agents LLM (agents/llm_client.py)
OPENROUTER_API_KEY=sk-or-v1-remplacer-par-votre-cle

# --- Données locales (développement) ---
# Chemin local vers le dossier contenant les données (sous-dossiers LOAD_LOCK_AAAAMM)
DATA_DIR=./data

# --- AWS (utilisé uniquement au déploiement, laisser vide en local) ---
# Identifiants AWS explicites. Peuvent rester vides : en déploiement sur EC2
# avec un rôle IAM attaché, ingestion/s3_client.py fonctionne sans ces clés.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
# Nom du bucket S3 contenant les données à auditer et les rapports générés
S3_BUCKET=
# Préfixe des fichiers de données à auditer dans le bucket
S3_INPUT_PREFIX=input/
# Préfixe où sont déposés les rapports générés (module reporting/, à venir)
S3_REPORTS_PREFIX=reports/
