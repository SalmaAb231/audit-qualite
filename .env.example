# Exemples uniquement : copier vers un fichier privé, jamais le publier.
# Déploiement EC2 : rôle IAM, aucune clé AWS statique dans ce fichier.
OPENROUTER_API_KEY=replace_with_your_key
DATA_DIR=./data
STORAGE_MODE=s3
# Développement avec des fichiers locaux : choisir STORAGE_MODE=local.

# S3 : sur un PC, utiliser un profil AWS CLI hors du dépôt si nécessaire.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY sont lus par config.py,
# mais doivent rester ABSENTS du fichier de production EC2.
AWS_REGION=eu-west-1
S3_BUCKET=your-project-bucket
S3_INPUT_PREFIX=input/
S3_REPORTS_PREFIX=reports/
S3_QUARANTINE_PREFIX=quarantine/
S3_HISTORY_PREFIX=history/

# Cache dashboard des artefacts immuables (HTML/JSON/source), en secondes.
ARTIFACT_CACHE_TTL_SECONDS=900
