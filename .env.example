# Copier ce fichier vers .env et renseigner ses propres identifiants.
# Ne jamais publier le fichier .env.
OPENROUTER_API_KEY=
DATA_DIR=./data

# Facultatif : uniquement pour l'utilisation de S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET=
S3_INPUT_PREFIX=input/
S3_REPORTS_PREFIX=reports/
